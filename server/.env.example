# ── Teosofia App — variáveis de ambiente ─────────────────────────
# Copie este arquivo para `.env` e preencha os valores.

# Porta do servidor
# ⚠️ NÃO usar 3000 — é do bridge do WhatsApp do Hermes. Use 3001.
PORT=3001

# Base do site de conteúdo (sem barra final)
SITE_BASE=https://showdeideias.com/teosofia

# TTL do cache de conteúdo em milissegundos (padrão 5 min)
CONTENT_TTL_MS=300000

# ── Push Notifications (Web Push / VAPID) ─────────────────────────
# Gere as chaves com:  npm run keys
# Depois cole os valores abaixo.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Email de contato para o provedor de push (obrigatório)
VAPID_SUBJECT=mailto:contato@teosofia.org

# ── Agendador diário ──────────────────────────────────────────────
# Hora (0-23) e minuto do envio diário, no fuso do servidor.
PUSH_HOUR=7
PUSH_MINUTE=0

# ── Segurança ─────────────────────────────────────────────────────
# Token para o endpoint de envio manual de push (POST /api/push/send).
# Use um valor longo e aleatório.
ADMIN_TOKEN=troque-por-um-token-longo-e-secreto
